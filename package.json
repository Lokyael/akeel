{
  "name": "akeel",
  "version": "0.1.0",
  "description": "Engineering skills and user-space access decisions for Pi-based AI coding",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "tsx scripts/validate-docs.ts && tsx scripts/validate-skills.ts && tsc --noEmit && tsx --test \"tests/access-gate/**/*.test.ts\" \"tests/context-pruner/**/*.test.ts\" \"tests/guidance/**/*.test.ts\" \"tests/validate-docs.test.ts\" \"tests/validate-packages.test.ts\" \"tests/validate-skills.test.ts\"",
    "test:file": "tsx --test",
    "test:index": "tsx --test tests/access-gate/index.test.ts"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typebox": "^1.3.32",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./packages/guidance/src/bootstrap/index.ts",
      "./packages/guidance/src/artifact-exchange/pi-composition.ts",
      "./packages/guidance/src/record-containers/pi-composition.ts",
      "./packages/access-gate/src/access-gate",
      "./packages/context-pruner/src/context-pruner"
    ],
    "skills": [
      "./packages/guidance/skills/disciplines",
      "./packages/guidance/skills/workflows"
    ]
  }
}
