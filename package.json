{
  "name": "pi-keel",
  "description": "Engineering skills and security system for pi — the keel that keeps AI coding steady",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "tsx scripts/validate-docs.ts && tsx scripts/validate-skills.ts && tsc --noEmit && tsx --test \"tests/access-gate/**/*.test.ts\"",
    "test:profile": "tsx --test tests/access-gate/profile/*.test.ts",
    "test:path": "tsx --test tests/access-gate/path/*.test.ts",
    "test:gate": "tsx --test tests/access-gate/gate/*.test.ts tests/access-gate/plan/*.test.ts tests/access-gate/decision/*.test.ts",
    "test:shell-parse": "tsx --test tests/access-gate/shell-parse/*.test.ts",
    "test:cmd-semantics": "tsx --test tests/access-gate/command-semantics/*.test.ts tests/access-gate/config/*.test.ts",
    "test:index": "tsx --test tests/access-gate/index.test.ts",
    "test:footer": "tsx --test tests/access-gate/ui/*.test.ts"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/bootstrap/index.ts",
      "./src/access-gate"
    ],
    "skills": [
      "./skills/foundations",
      "./skills/disciplines",
      "./skills/workflows"
    ]
  }
}
